@model SimpleStore.Web.Models.Perfil

@section Scripts {
    <script src="~/js/CadastroCliente.js" asp-append-version="true"></script>
}

@{
    ViewData["HideSearchBar"] = true;
}

<head>
    <link rel="stylesheet" href="Index.css">
</head>


<!-- Conteúdo principal da página -->
<div class="fundo-branco">
    <form asp-action="Editar" method="post" id="form-endereco">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <h2>Editar Perfil</h2>

        <div class="form-floating mt-4 mb-3">
            <input asp-for="EmailComp" type="email" class="form-control" id="email" placeholder="exemplo@gmail.com" />
            <label for="email">E-mail</label>
            <span asp-validation-for="EmailComp" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="form-floating mb-3 col-6">
                <input asp-for="SenhaComp" type="password" class="form-control" id="senha" placeholder="123@exemplo" />
                <label for="senha">Senha</label>
                <span asp-validation-for="SenhaComp" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3 col-6">
                <input asp-for="ConfirmarSenhaComp" type="password" class="form-control" id="confirmarSenha" placeholder="123@exemplo" />
                <label for="confirmarSenha">Confirmar Senha</label>
                <span asp-validation-for="ConfirmarSenhaComp" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 col-lg-6">
                <h5>Dados pessoais</h5>

                <div class="form-floating mt-3 mb-3">
                    <input asp-for="NomeComp" type="text" class="form-control" id="nome" placeholder="João Sebastião da Silva" />
                    <label for="nome">Nome</label>
                    <span asp-validation-for="NomeComp" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="text-center mt-2">
            <button type="submit" class="btn btn-primary btn-padrao btn-lg">Salvar</button>
        </div>
    </form>
</div>