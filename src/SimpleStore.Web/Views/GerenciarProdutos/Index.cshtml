@model IEnumerable<Produto>

@{
    ViewData["HideSearchBar"] = true;
}

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}

<div class="container my-4">
    <!-- Título da Página -->
    <h2 class="mb-4 text-start">Gerenciar Produtos</h2>

    <div class="row">
        <div class="col-9 d-flex mb-4 ">
            <input type="text" class="form-control campo-buscar border-0" placeholder="Pesquisar produto" aria-label="Pesquisar produto">
            <button class="btn campo-buscar btn-outline btn-secundario" type="button">
                <i class="ri-search-line ri-xl"></i>
            </button>
        </div>
        <div class="col-3 mb-4">
            <a class="btn btn-padrao w-100" href="/CadastroProduto">Novo Produto</a>
        </div>
    </div>

    @foreach (var produto in Model)
    {
        <!-- Lista de Produtos -->
        <div class="row g-1">
            <!-- Produto 1 -->
            <div class="col-md-12 mb-3">
                <div class="card fundo-card mb-4 p-3">
                    <div class="row">
                        <!-- Imagem do Produto -->
                        <div class="col-md-3">
                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(produto.ImgUrl)" alt="@produto.NomeProd" class="card-img-top" height="150" />
                        </div>
                        <!-- Detalhes do Produto -->
                        <div class="col-md-9">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="card-title"> <span m-4">Código do produto:</span> @produto.IdProd</p>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <a href="/Produtos/Edit/1" class="btn btn-editar btn-sm">Editar</a>
                                        <button class="btn btn-remover btn-sm ms-2">Deletar</button>
                                    </div>
                                </div>

                                <h4 class="card-title"> @produto.NomeProd</h4>
                                <p class="card-text">@produto.DescProd</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="card-text">
                                            <small class="text-muted">Estoque: @produto.QuantProd  |  Categoria: @produto.CategProd </small>
                                        </p>
                                    </div>
                                    <div><span class="preco">Preço: R$ <strong>@produto.PrecoProd.ToString("F2")</strong></span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>