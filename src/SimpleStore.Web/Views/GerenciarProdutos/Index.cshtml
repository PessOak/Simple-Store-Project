@model IEnumerable<Produto>

@{
    ViewData["HideSearchBar"] = true;
}

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}

<div class="container my-4">
    <!-- Título da Página -->
    <h1 class="mb-4 text-start">Gerenciar Produtos</h1>

    <!-- Botão "Novo Produto" -->
    <div class="d-flex justify-content-end mb-3">
        <a href="CadastroProduto" class="btn">Novo Produto</a>
    </div>

    <!-- Campo de Pesquisa -->
    <div class="input-group mb-4">
        <input type="text" class="form-control" placeholder="Pesquisar produto" aria-label="Pesquisar produto">
        <button class="btn btn-outline-secondary" type="button">
            <i class="bi bi-search"></i> <!-- Ícone de busca (Bootstrap Icons) -->
        </button>
    </div>

    @foreach (var produto in Model)
    {
        <!-- Lista de Produtos -->
        <div class="row">
            <!-- Produto 1 -->
            <div class="col-md-12 mb-3">
                <div class="card">
                    <div class="row g-0">
                        <!-- Imagem do Produto -->
                        <div class="col-md-2">
                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(produto.ImgUrl)" alt="@produto.NomeProd" class="card-img-top" height="200" />
                        </div>
                        <!-- Detalhes do Produto -->
                        <div class="col-md-8">
                            <div class="card-body">
                                <p class="card-title">Código do produto: <strong>@produto.IdProd</strong></p>
                                <h4 class="card-title"> Nome do produto: @produto.NomeProd</h4>
                                <p class="card-text">@produto.DescProd</p>
                                <p class="card-text">
                                    <small class="text-muted">Estoque: @produto.QuantProd | Categoria: @produto.CategProd | Preço: @produto.PrecoProd</small>
                                </p>
                            </div>
                        </div>
                        <!-- Botões de Ação -->
                        <div class="col-md-2 d-flex flex-column justify-content-center align-items-center">
                            <a href="/Produtos/Edit/1" class="btn btn-primary btn-sm mb-2">Editar</a>
                            <button class="btn btn-danger btn-sm">Deletar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>