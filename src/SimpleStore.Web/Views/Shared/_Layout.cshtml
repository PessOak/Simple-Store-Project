<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simple Store</title>
    <!-- Importação do ícone que fica na parte de cima na aba do navegador -->
    <link rel="shortcut icon" href="~/img/logotipo/favicon.svg" type="image/x-icon">
    <!-- Importação do css do bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Importação da familia de fontes montserrat -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
          rel="stylesheet">
    <!-- Importação ícones remix-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" rel="stylesheet" />
    <!-- Importação do js do bootstrap -->
    <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    <!-- Não apague esses abaixo -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SimpleStore.Web.styles.css" asp-append-version="true" />
</head>

<body>

    <!-- Cabeçalho da página -->
    <header class="fixed-top">
        <nav class="navbar navbar-expand-lg custom-navbar">
            <div class="container-fluid">
                <a class="navbar-brand" href="../Home/Index.cshtml">
                    <img class="logotipo d-inline-block align-text-top" src="~/img/logotipo/simplestore-grande.png"
                         width="150" alt="Logo">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse alinhamento-conteudo" id="navbarNav">
                    @if (ViewData["HideSearchBar"] == null || !(bool)ViewData["HideSearchBar"])
                    {
                        <form class="d-flex mx-auto" role="search" style="width: 60%;">
                            <input class="form-control campo-buscar border-0" type="search" placeholder="Buscar Produto"
                                   aria-label="Search" style="flex-grow: 1;">
                            <button class="btn btn-outline btn-secundario" type="submit">
                                <i class="ri-search-line ri-xl"></i>
                            </button>
                        </form>
                    }

                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="btn-group nav-item me-3 ri-lx align-items-center">
                            <a class="link-entrar nav-link ps-0 cor-branca-hover" data-bs-toggle="dropdown"
                               data-bs-auto-close="true" aria-expanded="false">Entrar</a>
                            <ul class="dropdown-menu rounded-1 bg-dropdown">
                                <li><a class="nav-link link-comprador p-3" href="#">Comprador</a></li>
                                <li><a class="nav-link link-vendedor p-3" href="#">Vendedor</a></li>
                            </ul>
                        </li>

                        <li class="nav-item me-3">
                            <a class="nav-link cor-verde-hover" href="#">
                                <i class="ri-shopping-cart-line ri-lg cor-verde-hover"></i>
                            </a>
                        </li>

                        <li class="nav-item me-3 link">
                            <a class="nav-link text-white me-4 cor-verde-hover" href="#">Pedidos</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody() <!-- Aqui será inserido o conteúdo específico da página -->
    </main>

    <!-- Rodapé da página -->
    <footer>
        <div class="p-4 mt-2 mb-2">
            <div class="text-center">
                <p class="mb-1">
                    <strong>&copy; 2024 SimpleStore.</strong> Todos os direitos reservados.
                </p>
            </div>

            <div class="text-center">
                <p class="m-0">
                    Precisa de ajuda?
                    <a class="email" href="mailto:simplestore@gmail.com">
                        Fale com a gente.
                    </a>
                </p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4"
            crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
