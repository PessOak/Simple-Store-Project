@model IEnumerable<Produto>

<h2 class="text-center">Produtos</h2>

<div class="container mt-4">
    <div class="row">
        @foreach (var produto in Model)
        {
            <div class="col-md-4 mb-4 produto" data-nome="@produto.NomeProd">
                <div class="card text-center">

                    @if (produto.ImgUrl != null && produto.ImgUrl.Length > 0)
                    {
                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(produto.ImgUrl)" alt="@produto.NomeProd" class="card-img-top" />
                    }
                    else
                    {
                        <img src="~/img/placeholder.jpg" alt="Imagem Padrão" class="card-img-top" />
                    }

                    <div class="card-body">
                        <h5 class="card-title">@produto.NomeProd</h5>
                        <p class="card-text">Preço: @produto.PrecoProd.ToString("C")</p>
                        <p class="card-text">Descrição: @produto.DescProd</p>
                        <a href="@Url.Action("Details", new { nome = produto.NomeProd })" class="btn">Ver detalhes</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script src="~/js/Produto.js" asp-append-version="true"></script>
