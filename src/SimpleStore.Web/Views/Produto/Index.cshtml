@{
}

<div class="fundo-branco" id="margem-externa">
    <div class="row conteudo-principal ">
        <!-- Coluna esquerda: parte da imagem e detalhes do produto -->
        <div class="col-6">
            <div class="row coluna-imagens d-flex">
                <div class="d-flex flex-column col-3 p-0" id="thumbnails">

                    <img src="../imgs/2.jpg" alt="Imagem 1" class="imagem-carrossel mb-2" onclick="changeImage(this)"
                         id="img1">

                    <img src="../imgs/1.jpg" alt="Imagem 2" class="imagem-carrossel mb-2" onclick="changeImage(this)">

                    <img src="../imgs/3.jpg" alt="Imagem 3" class="imagem-carrossel mb-2" onclick="changeImage(this)">

                    <img src="../imgs/4.jpg" alt="Imagem 3" class="imagem-carrossel" onclick="changeImage(this)">
                </div>

                <div class="col-9" id="main-img">
                    <img alt="Imagem do Produto" id="main-image" class="img-fluid">
                </div>
            </div>
        </div>

        <!-- Coluna direita: detalhes do produto -->
        <div class="col-4 coluna-info-produtos ps-0" id="info-produto">
            <h2 class="">Nome do Produto</h2>
            <p><span>R$ 299,99</span></p>
            <p>
                Descrição detalhada do produto, incluindo informações técnicas, funcionalidades e outros detalhes
                importantes.
            </p>
            <ul>
                <li>
                    Lorem ipsum dolor sit amet consectetur adipisicing elit. Odio consequatur harum quidem facilis rerum,
                    quia, aut minima aliquid earum voluptatibus beatae maxime tenetur architecto aperiam doloribus soluta
                    culpa deleniti voluptate!
                </li>
                <li>
                    Lorem ipsum dolor sit amet consectetur, adipisicing elit. Consectetur voluptatem autem quisquam quod at
                    labore dignissimos? Reprehenderit assumenda excepturi dolorem.
                </li>
                <li>
                    Lorem ipsum dolor sit amet consectetur, adipisicing elit. Voluptatum, ab.
                </li>
            </ul>
        </div>

        <!-- Coluna para o carrinho de compra -->
        <div class="col-2 coluna-finalizar-pedido" id="carrinho_pedido">

            <div>
                <h3>Finalizar Pedido</h3>
                <div class="text-center mt-3">
                    <label for="product-quantity" class="form-label">Quantidade</label>

                    <div class="input-group flex-nowrap btn-quantidade">
                        <button class="btn btn-outline-secondary btn-menos" type="button"
                                onclick="decreaseQuantity()">
                            -
                        </button>

                        <input type="number" id="product-quantity" class="form-control text-center quantidade-produto" value="1"
                               min="1" aria-label="Quantidade de produtos" style="appearance: none; -moz-appearance: textfield;">

                        <button class="btn btn-outline-secondary btn-mais" type="button" onclick="increaseQuantity()">+</button>
                    </div>
                </div>

                <p class="frete"><strong>Frete:</strong> Combinar com o vendedor</p>

                <p><strong>Prazo de entrega:</strong> Combinar com o vendedor</p>

                <div class="d-flex justify-content-center">
                    <button class="btn text-white mt-2 btn-padrao">
                        Adicionar ao
                        carrinho
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="nota-produto pt-5">
        <div class=" ">
            <h2>Nota do Produto</h2>
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
        </div>
        <div class="">
        </div>
    </div>
</div>
