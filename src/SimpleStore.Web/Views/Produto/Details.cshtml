@section Scripts {
        <script src="~/js/DetalheProduto.js" asp-append-version="true"></script>
}
@model Produto
<head>
    <link rel="stylesheet" href="Index.css">
</head>


<div class="fundo-branco" id="margem-externa">
    <div class="row conteudo-principal ">
        <!-- Coluna esquerda: parte da imagem e detalhes do produto -->
        <div class="col-6">
            <div class="row coluna-imagens d-flex">
                <div class="d-flex flex-column col-3 p-0" id="thumbnails">

                    @if (!string.IsNullOrEmpty(Model.ImgUrl))
                    {
                        <img src="@Model.ImgUrl" alt="@Model.NomeProd" class="product-image mb-2 imagem-carrossel" onclick="changeImage(this)" id="img1">
                    }
                    <img src="@Model.ImgUrl" alt="@Model.NomeProd" class="imagem-carrossel product-image mb-2" onclick="changeImage(this)" id="img1">

                    <img src="@Model.ImgUrl" alt="@Model.NomeProd" class="imagem-carrossel product-image mb-2" onclick="changeImage(this)">

                    <img src="@Model.ImgUrl" alt="@Model.NomeProd" class="imagem-carrossel product-image mb-2" onclick="changeImage(this)">

                </div>

                <div class="col-9" id="main-img">
                    <img alt="Imagem do Produto" id="main-image" class="img-fluid">
                </div>
            </div>
        </div>

        <!-- Coluna direita: detalhes do produto -->
        <div class="col-4 coluna-info-produtos ps-0" id="info-produto">
            <h2 class="">@Model.NomeProd</h2>
            <p><span>R$ @Model.PrecoProd.ToString("C")</span></p>
            <ul>
                <li>
                    @Model.DescProd
                </li>
            </ul>
        </div>

        <!-- Coluna para o carrinho de compra -->
        <div class="col-2 coluna-finalizar-pedido" id="carrinho_pedido">

            <div>

                <form asp-action="AdicionarAoCarrinho" asp-controller="ProdutoCarrinho" method="post">
                    <input type="hidden" name="idCarrinho" value="@Model.IdCarrinho" />  <!-- TESTE produtocarrinho, remover essa linha ou modifica-la! -->               
                    <input type="hidden" name="produtoId" value="@Model.IdProd" />

                    <div class="text-center mt-3">
                        <label for="product-quantity" class="form-label">Quantidade</label>

                        <div class="input-group flex-nowrap btn-quantidade">
                            <button class="btn btn-outline-secondary btn-menos" type="button" onclick="decreaseQuantity()">
                                -
                            </button>

                            <input type="number" id="product-quantity" class="form-control text-center quantidade-produto" name="quantidade"
                                value="1" min="1" aria-label="Quantidade de produtos"
                                style="appearance: none; -moz-appearance: textfield;">

                            <button class="btn btn-outline-secondary btn-mais" type="button"
                                onclick="increaseQuantity()">+</button>
                        </div>
                    </div>

                    <p class="frete"><strong>Frete:</strong> Combinar com o vendedor</p>

                    <p><strong>Prazo de entrega:</strong> Combinar com o vendedor</p>

                    <div class="d-flex justify-content-center">
                        <button class="btn text-white mt-2 btn-padrao">
                            Adicionar ao 
                            carrinho
                        </button>
                    </div>

                    <div class="d-flex justify-content-center">
                        <button class="btn text-white mt-2 btn-padrao">
                            Comprar agora
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
    @* <div class="nota-produto pt-5">
        <div class=" ">
            <h2>Nota do Produto</h2>
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
        </div>
    </div> *@
    <div class="pt-5"><a href="@Url.Action("Index", "Produto")" class="notaProd">Ver mais produtos</a>
        </div>
    
</div>


<script src="Index.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4"
    crossorigin="anonymous"></script>