@section Scripts {
    <script src="~/js/CadastroCliente.js" asp-append-version="true"></script>
}

@{
    ViewData["HideSearchBar"] = true;
}

@model Perfil

<head>
    <link rel="stylesheet" href="~/css/Index.css">
</head>

<!-- Conteúdo principal da página -->
<div class="fundo-branco">
    <form id="form-endereco" asp-action="Editar" asp-controller="Perfil" method="post">

        <h2>Editar Perfil</h2>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-floating mt-4 mb-3">
            <input asp-for="EmailComp" type="email" class="form-control" id="email" placeholder="examplo@gmail.com">
            <label asp-for="EmailComp">E-mail</label>
            <span asp-validation-for="EmailComp" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="form-floating mb-3 col-6">
                <input asp-for="SenhaComp" type="password" class="form-control" id="senha" placeholder="@@123exemplo">
                <label asp-for="SenhaComp">Senha</label>
                <span asp-validation-for="SenhaComp" class="text-danger"></span>
            </div>
            <div class="form-floating mb-4 col-6">
                <input asp-for="SenhaComp" type="password" class="form-control" id="confirmarSenha" placeholder="@@123exemplo">
                <label asp-for="SenhaComp">Confirmar Senha</label>
                <span asp-validation-for="SenhaComp" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 col-lg-6">
                <h5>Dados pessoais</h5>

                <div class="form-floating mt-3 mb-3">
                    <input asp-for="NomeComp" type="text" class="form-control" id="nome" placeholder="João Sebastião da Silva">
                    <label asp-for="NomeComp">Nome</label>
                    <span asp-validation-for="NomeComp" class="text-danger"></span>
                </div>

                <div class="form-floating mt-3 mb-3">
                    <input asp-for="FoneComprador.FoneComp" type="tel" class="form-control" id="celular" placeholder="31999999999">
                    <label asp-for="FoneComprador.FoneComp">Celular</label>
                    <span asp-validation-for="FoneComprador.FoneComp" class="text-danger"></span>
                </div>

                <div class="form-floating mt-3 mb-4">
                    <input asp-for="CpfComp" type="text" class="form-control" id="cpf" placeholder="11111111111">
                    <label asp-for="CpfComp">CPF</label>
                    <span asp-validation-for="CpfComp" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-12 col-lg-6">
                <h5>Endereço</h5>

                <div class="form-floating mt-3 mb-3">
                    <input asp-for="EnderecoComprador.CepEndereco" type="text" class="form-control" id="cep" placeholder="Digite o CEP"
                           onblur="buscarEndereco()" onkeyup="verificarEnter(event)" required>
                    <label asp-for="EnderecoComprador.CepEndereco">CEP</label>
                    <span asp-validation-for="EnderecoComprador.CepEndereco" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="form-floating col-9">
                        <input asp-for="EnderecoComprador.LogradouroEndereco" type="text" class="form-control" id="logradouro" disabled
                               placeholder="Rua Nossa Senhora do Carmo" readonly>
                        <label asp-for="EnderecoComprador.LogradouroEndereco">Logradouro</label>
                    </div>

                    <div class="form-floating col-3">
                        <input asp-for="EnderecoComprador.NumeroEndereco" type="text" class="form-control" id="numero" placeholder="Número">
                        <label asp-for="EnderecoComprador.NumeroEndereco">Número</label>
                        <span asp-validation-for="EnderecoComprador.NumeroEndereco" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 mb-3">
                        <input asp-for="EnderecoComprador.BairroEndereco" type="text" disabled class="form-control" id="bairro" placeholder="Bairro" readonly>
                        <label asp-for="EnderecoComprador.BairroEndereco">Bairro</label>
                    </div>

                    <div class="col-9 form-floating">
                        <input asp-for="EnderecoComprador.CidadeEndereco" type="text" class="form-control" disabled id="cidade" placeholder="Cidade" readonly>
                        <label asp-for="EnderecoComprador.CidadeEndereco">Cidade</label>
                    </div>

                    <div class="col-3 form-floating">
                        <input asp-for="EnderecoComprador.EstadoEndereco" type="text" class="form-control" disabled id="estado" placeholder="Estado" readonly>
                        <label asp-for="EnderecoComprador.EstadoEndereco">Estado</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-2">
            <button type="submit" class="btn btn-primary btn-padrao btn-lg">Editar</button>
        </div>

        <div class="text-center mt-4">
            <p class="mb-0">
                <i class="ri-question-line" width="200px"></i> Já possui uma conta?
                <a class="email" asp-controller="LoginCliente" asp-action="Index">
                    ENTRAR.
                </a>
            </p>
        </div>
    </form>
</div>
