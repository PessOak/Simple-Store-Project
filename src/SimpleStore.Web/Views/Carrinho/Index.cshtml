@model Carrinho

<main class="container">
    <h2 class="text-start my-4">Carrinho de compras</h2>

    @if (Model.Produtos != null && Model.Produtos.Any() && Model.Produtos.First().Produto.NomeProd != null)
    {
        <div class="row">
            <!-- Lista de Produtos no Carrinho -->
            <div class="col-md-9">
                @foreach (var produtoCarrinho in Model.Produtos)
                {
                    <div class="cart-item card-fundo mb-4 p-3 border rounded">
                        <div class="row align-items-center">
                            <div class="col-3">
                                <img src="data:image/jpeg;base64,@Convert.ToBase64String(produtoCarrinho.Produto.ImgUrl)" alt="@produtoCarrinho.Produto.NomeProd" class="card-img-top" />
                            </div>
                            <div class="col-7">
                                <h5 class="mb-1">@produtoCarrinho.Produto.NomeProd</h5>
                                <p class="mb-1 text-muted">@produtoCarrinho.Produto.DescProd</p>
                                <p class="mb-0">
                                    <strong>Preço Unitário:</strong>
                                    @produtoCarrinho.Produto.PrecoProd.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))
                                </p>
                                <p class="mb-0">
                                    <strong>Total:</strong>
                                    @((produtoCarrinho.QuantProdCarrinho * produtoCarrinho.Produto.PrecoProd).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")))
                                </p>
                            </div>
                            <div class="col-2 text-end">
                                <p class="mb-3"><strong>Quantidade:</strong> @produtoCarrinho.QuantProdCarrinho</p>
                                <form asp-action="RemoverProduto" method="post">
                                    <input type="hidden" name="idProduto" value="@produtoCarrinho.IdProd" />
                                    <button type="submit" class="btn btn-remover btn-sm">Remover</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Resumo do Pedido -->
            <div class="col-md-3">
                <div class="cart-summary card-fundo p-3 border rounded">
                    <h4>Resumo do Pedido</h4>
                    <hr>
                    <p><strong>Valor Total:</strong> @Model.ValorTotalCarrinho.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</p>
                    <form asp-action="FinalizarCompra" method="post">
                        <input type="hidden" name="idCarrinho" value="@Model.IdCarrinho" />
                        <button type="submit" class="btn btn-padrao mt-2">Finalizar Compra</button>
                    </form>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center mt-5">
            Seu carrinho está vazio! Explore nossos <a href="@Url.Action("Index", "Produto")">produtos</a>.
        </div>
    }
</main>






